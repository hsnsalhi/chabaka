# iOS 14+ — cf. CLAUDE.md (cibles V1)
platform :ios, '14.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end

  # --- chabaka_engine xcframework -------------------------------------------
  # Le xcframework est généré par tools/build-rust/build_ios.sh et déposé dans
  # ios/Frameworks/chabaka_engine.xcframework (gitignored — artefact de build).
  # On l'ajoute au target Runner avec Embed & Sign pour que dart:ffi puisse
  # charger la lib sur device et simulator.
  xcframework_path = File.expand_path(
    File.join('Frameworks', 'chabaka_engine.xcframework'),
    File.dirname(File.realpath(__FILE__))
  )

  if File.exist?(xcframework_path)
    runner_target = installer.aggregate_targets
      .find { |t| t.name == 'Runner' }

    if runner_target
      runner_target.xcconfigs.each do |config_name, xcconfig|
        # Ajoute le chemin de recherche du framework pour que le linker le trouve
        xcconfig.merge!({
          'FRAMEWORK_SEARCH_PATHS' => "$(inherited) #{File.dirname(xcframework_path)}",
        })
        xcconfig_path = runner_target.xcconfig_path(config_name)
        xcconfig.save_as(Pathname.new(xcconfig_path))
      end
    end

    # Ajoute le xcframework directement au projet Xcode Runner (si absent)
    runner_pbx = installer.pods_project
    # Note : l'ajout xcframework natif dans pbxproj via Ruby nécessite xcodeproj gem.
    # Le Podfile le signale ; on préfère un script de phase de build Xcode à la place.
    puts "[chabaka] xcframework trouvé : #{xcframework_path}"
    puts "[chabaka] Vérifiez que chabaka_engine.xcframework est bien listé dans"
    puts "[chabaka]   Runner > General > Frameworks, Libraries, and Embedded Content"
    puts "[chabaka]   avec 'Embed & Sign'."
  else
    puts "[chabaka] AVERTISSEMENT : xcframework absent — générez-le avec :"
    puts "[chabaka]   ./tools/build-rust/build_ios.sh"
    puts "[chabaka] Le build iOS fonctionnera sans la lib Rust (fallback Dart actif)."
  end
  # --------------------------------------------------------------------------
end
